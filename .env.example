# --- PostgreSQL ---
DB_NAME=openbrain
DB_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-run-setup-sh

# --- pgvector dimension ---
# ONE-WAY DOOR: baked into the embedding column at first boot. Changing it
# after the db volume exists requires `docker compose down`, deleting the
# db_data volume, and re-embedding everything. See README before touching
# this on a volume that already has data.
EMBED_DIM=768

# --- LM Studio ---
# Reaches LM Studio running on the SAME machine as `docker compose up`, on
# its default port. Point this at a LAN IP instead if LM Studio runs on a
# separate machine (e.g. a GPU workstation): http://192.168.1.50:1234/v1
LM_STUDIO_URL=http://host.docker.internal:1234/v1

# Model identifiers exactly as LM Studio's "Local Server" tab shows them.
# No default -- the server refuses to start without these set.
# Examples: text-embedding-nomic-embed-text-v1.5, qwen2.5-7b-instruct
EMBEDDING_MODEL=
CHAT_MODEL=

# --- MCP server ---
MCP_ACCESS_KEY=CHANGE-ME-run-setup-sh
MCP_PORT=8000
